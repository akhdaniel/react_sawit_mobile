{
  "expo": {
    "name": "Xerpium Sawit",
    "slug": "xerpium-sawit-mobile",
    "scheme": "xerpiumsawit",
    "version": "0.9.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xerpium.sawit"
    },
    "android": {
      "package": "com.xerpium.sawit",
      "adaptiveIcon": {
        "backgroundColor": "#0B5D1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.NFC"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "versionCode": 12
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai untuk mencatat posisi transaksi di blok."
        }
      ],
      "expo-background-task",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Bluetooth dipakai untuk printer thermal."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-status-bar",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "NFC dipakai untuk membaca kartu pekerja.",
          "selectIdentifiers": [],
          "systemCodes": [],
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8080/xsm/v1",
      "estateUtcOffsetMinutes": 420,
      "autoLockMinutes": 5,
      "workStartTime": "06:30",
      "restanCutoff": "16:00"
    }
  }
}
